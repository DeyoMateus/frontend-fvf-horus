# Copie para .env.production (ou configure como Environment Variable no
# painel da Vercel: Project Settings > Environment Variables).
# Aponta para o backend hospedado na Hostinger (domínio/IP + porta/proxy
# reverso que você configurar lá).
VITE_API_URL=https://api.seu-dominio.com.br

# Notificações nativas do navegador (alertas, ajustes, LGPD, radar). Ligadas por padrão.
# Durante testes de carga, deixe false para não encher a bandeja; retire a linha (ou use true) para religar.
# VITE_NOTIFICACOES_DESKTOP=false
